{
  "name": "language-learning-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lessons:audio": "vite-node --script scripts/synthesize-lessons.ts",
    "lessons:check": "vite-node --script scripts/synthesize-lessons.ts --status",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "^2.115.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^5.4.20",
    "vite-node": "^2.1.9",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^2.1.9"
  }
}
